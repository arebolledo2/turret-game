extends GutTest

func before_each() -> void:
	TestHelpers.reset_all_services()

func test_preferences_round_trip_and_reject_invalid_types() -> void:
	var service := preload("res://scripts/autoload/settings_service.gd").new()
	service.preferences_path = "user://preferences_%d.cfg" % Time.get_ticks_usec()
	add_child_autofree(service)
	service.set_fullscreen(true, false)
	service.set_vsync(false, false)
	service.set_reduced_motion(true, false)
	service.set_sfx_volume(.35, false)
	service.set_ground_markers(SettingsService.GroundMarkers.OFF, false)
	assert_eq(service.save_preferences(), OK)
	service.set_fullscreen(false, false)
	service.set_vsync(true, false)
	service.set_reduced_motion(false, false)
	service.set_sfx_volume(.9, false)
	service.set_ground_markers(SettingsService.GroundMarkers.ALL, false)
	service.load_preferences()
	assert_eq(service.ground_markers, SettingsService.GroundMarkers.OFF)
	assert_almost_eq(service.sfx_volume, .35, .001)
	assert_true(service.fullscreen)
	assert_false(service.vsync)
	assert_true(FeatureFlagService.is_enabled(FeatureFlagService.REDUCED_MOTION))
	var config := ConfigFile.new()
	config.set_value("display", "fullscreen", "bad")
	config.set_value("audio", "sfx_volume", "bad")
	config.set_value("accessibility", "ground_markers", 99)
	config.save(service.preferences_path)
	service.load_preferences()
	assert_eq(service.ground_markers, SettingsService.GroundMarkers.OFF)
	assert_true(service.fullscreen, "Malformed values must not overwrite valid preferences")
	assert_almost_eq(service.sfx_volume, .35, .001)
	service.set_sfx_volume(0, false)
	assert_true(AudioServer.is_bus_mute(AudioServer.get_bus_index("SFX")))
	service.set_sfx_volume(2.0, false)
	assert_eq(service.sfx_volume, 1.0)
	assert_false(AudioServer.is_bus_mute(AudioServer.get_bus_index("SFX")))
	service.set_sfx_volume(NAN, false)
	assert_eq(service.sfx_volume, 1.0)
	DirAccess.remove_absolute(service.preferences_path)
	SettingsService.apply_audio_preferences()
	SettingsService.apply_display_preferences()
	SettingsService.set_reduced_motion(false, false)

func test_window_size_persists_and_rejects_invalid_values() -> void:
	var service := preload("res://scripts/autoload/settings_service.gd").new()
	service.preferences_path = "user://preferences_%d.cfg" % Time.get_ticks_usec()
	add_child_autofree(service)
	service.set_window_size(Vector2i(1600, 900), false)
	assert_eq(service.save_preferences(), OK)
	service.window_size = Vector2i.ZERO
	service.load_preferences()
	assert_eq(service.window_size, Vector2i(1600, 900))
	var config := ConfigFile.new()
	config.set_value("display", "window_width", 10)
	config.set_value("display", "window_height", "bad")
	config.save(service.preferences_path)
	service.load_preferences()
	assert_eq(service.window_size, Vector2i(1600, 900), "Invalid sizes must not overwrite a valid one")
	DirAccess.remove_absolute(service.preferences_path)

func test_fit_window_size_keeps_the_window_on_screen() -> void:
	var script := preload("res://scripts/autoload/settings_service.gd")
	assert_eq(script.fit_window_size(Vector2i(1280, 720), Vector2i(1920, 1040)), Vector2i(1280, 720))
	assert_eq(script.fit_window_size(Vector2i(2560, 1440), Vector2i(1920, 1040)), Vector2i(1920, 1000))
	assert_eq(script.fit_window_size(Vector2i(100, 100), Vector2i(1920, 1040)), script.MIN_WINDOW_SIZE)

func test_shop_price_policies_remain_independent_of_retired_scene_manager() -> void:
	EconomyService.turrets_purchased = 2
	assert_eq(EconomyService.calculate_turret_price(10, 5), 40)
	assert_eq(EconomyService.calculate_item_price(20, 1), 24)
	assert_eq(EconomyService.calculate_item_price(20, 5), 40)
	ModifierService.add_modifier({"id": "discount", "stat": "shop_price_mult", "operation": "increase", "value": -.25})
	assert_eq(EconomyService.calculate_item_price(20, 5), 30)
	assert_eq(EconomyService.calculate_turret_price(10, 5), 30)

func test_run_choices_persist_and_invalid_saved_choices_are_ignored() -> void:
	var service := preload("res://scripts/autoload/settings_service.gd").new()
	service.preferences_path = "user://run_preferences_%d.cfg" % Time.get_ticks_usec()
	add_child_autofree(service)
	service.set_run_difficulty(GameEnums.Difficulty.BRUTAL, false)
	service.set_run_mode(RunConfig.MODE_CONVOY, false)
	assert_eq(service.save_preferences(), OK)
	service.run_difficulty = GameEnums.Difficulty.EASY
	service.run_mode = RunConfig.MODE_SURVIVE
	service.load_preferences()
	assert_eq(service.run_difficulty, GameEnums.Difficulty.BRUTAL)
	assert_eq(service.run_mode, RunConfig.MODE_CONVOY)
	var config := ConfigFile.new()
	config.set_value("run", "difficulty", 999)
	config.set_value("run", "mode", "missing")
	config.save(service.preferences_path)
	service.load_preferences()
	assert_eq(service.run_difficulty, GameEnums.Difficulty.BRUTAL)
	assert_eq(service.run_mode, RunConfig.MODE_CONVOY)
	DirAccess.remove_absolute(service.preferences_path)

func test_old_saved_build_zone_flag_stays_disabled_for_balance_pass() -> void:
	var config := ConfigFile.new()
	config.set_value("dev_flags", FeatureFlagService.BUILD_ZONES, true)
	FeatureFlagService.set_enabled(FeatureFlagService.BUILD_ZONES, true)
	SettingsService.load_dev_flags(config)
	assert_false(FeatureFlagService.is_enabled(FeatureFlagService.BUILD_ZONES))
	assert_false(FeatureFlagService.get_definition(FeatureFlagService.BUILD_ZONES)["default"])
